{
  "name": "@zanescope/v-local-key-provider",
  "version": "0.1.0-dev.0",
  "description": "可选的本地 Windows/macOS 密钥候选提供器（v-local-key-provider/v1 协议）",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanescope/v-local-key-provider.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "contentPolicy": {
    "class": "dual-use"
  },
  "bin": {
    "v-local-key-provider": "scripts/run.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js",
    "test": "node --test tests/*.test.js",
    "verify-release": "node scripts/verify-release.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": ["win32", "darwin"],
  "cpu": ["x64", "arm64"],
  "files": ["scripts/", "checksums.txt", "LICENSE", "DISCLOSURE"]
}
